# Copy to .env and fill in. Never commit the real .env.

# "development" | "production". In production the app REFUSES TO START with a weak/default SECRET_KEY,
# a wildcard CORS_ORIGINS, or an incomplete SMTP setup.
ENVIRONMENT=development

# Hosting platforms often give "postgres://..." URLs; that form is accepted too.
DATABASE_URL=postgresql+psycopg2://slotbook:slotbook@db:5432/slotbook

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (production needs >= 32 characters)
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Max time (ms) a request waits for a provider row lock before returning 503
LOCK_TIMEOUT_MS=5000

# Frontend origin(s) allowed to call the API from a browser, comma-separated, exact (no "*" in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Login lockout: this many FAILED logins per email+IP inside the window -> HTTP 429
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Email confirmations: "console" (just logs them), "smtp" (really sends) or "disabled"
EMAIL_BACKEND=console
EMAIL_FROM=SlotBook <no-reply@slotbook.local>
# Only needed when EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
