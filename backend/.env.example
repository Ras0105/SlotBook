# Copy to .env and fill in. Never commit the real .env.

# "development" | "production". In production the app REFUSES TO START with a weak/default SECRET_KEY,
# a wildcard CORS_ORIGINS, or an incomplete SMTP setup.
ENVIRONMENT=development

# Hosting platforms often give "postgres://..." URLs; that form is accepted too.
DATABASE_URL=postgresql+psycopg2://slotbook:slotbook@db:5432/slotbook

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (production needs >= 32 characters)
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Max time (ms) a request waits for a provider row lock before returning 503
LOCK_TIMEOUT_MS=5000

# Frontend origin(s) allowed to call the API from a browser, comma-separated, exact (no "*" in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Login lockout: this many FAILED logins per email+IP inside the window -> HTTP 429
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Forgot password: the emailed link is {FRONTEND_URL}/reset-password?token=...  (set this to your deployed frontend!)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS=5
PASSWORD_RESET_WINDOW_SECONDS=900

# Email confirmations: "console" (just logs them), "smtp" (really sends) or "disabled"
EMAIL_BACKEND=console
EMAIL_FROM=SlotBook <no-reply@slotbook.local>
# Only needed when EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587 -> SMTP_USE_TLS=true (STARTTLS).  Port 465 -> SMTP_SSL=true (implicit TLS; then SMTP_USE_TLS is ignored).
# The server's certificate is always verified. Check your settings with:
#   python -m app.scripts.send_test_email --to you@example.com
SMTP_USE_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ---- Reminders (email, and WhatsApp when switched on) ----
# Hours before the start that the reminder goes out.
REMINDER_HOURS_BEFORE=24
# Shared secret for the scheduler. Empty = the reminder endpoint is switched off (404).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# WhatsApp: disabled | console | twilio
WHATSAPP_BACKEND=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Optional approved WhatsApp template (needed to message people who have not written to you first)
TWILIO_CONTENT_SID=
